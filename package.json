{
  "name": "bantodesk",
  "version": "0.1.0",
  "description": "A desktop workspace for running many Claude Code sessions: an inbox, a manager agent that routes requests to per-folder queues, and a dashboard.",
  "license": "MIT",
  "author": "BridgeUI",
  "repository": {
    "type": "git",
    "url": "https://github.com/bridgeui/bantodesk.git"
  },
  "homepage": "https://github.com/bridgeui/bantodesk#readme",
  "bugs": {
    "url": "https://github.com/bridgeui/bantodesk/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "ai-agents",
    "electron",
    "terminal",
    "dashboard"
  ],
  "allowScripts": {
    "electron": true,
    "node-pty": true,
    "fsevents": false
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "release": "node scripts/release.js",
    "test": "node test/run.js"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "dockview-core": "8.8.3",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  }
}
